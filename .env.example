# MetricFlow AI - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control!

# OpenRouter API Configuration
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it
OPENROUTER_API_URL=https://openrouter.ai/api/v1
APP_URL=http://localhost:8501

# Mistral AI API Configuration
MISTRAL_API_KEY=your_mistral_api_key_here

# Application Environment (development/production)
STREAMLIT_ENVIRONMENT=development

# Logging Level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO
# PDF Generation Settings
# Page size options: A4, Letter, Legal
PDF_PAGE_SIZE=A4
# Margins in millimeters
PDF_MARGIN_TOP=20
PDF_MARGIN_RIGHT=15
PDF_MARGIN_BOTTOM=20
PDF_MARGIN_LEFT=15
# Render backgrounds and colors in PDF output
PDF_PRINT_BACKGROUND=true
# Timeout for PDF rendering in milliseconds
PDF_RENDER_TIMEOUT_MS=30000

# Frontend/UI Settings
# Primary brand color (hex)
UI_PRIMARY_COLOR=#2B6CB0
# Enable reduced motion for animations (true/false)
UI_REDUCED_MOTION=false
# Default locale
APP_LOCALE=pt-BR

# Feature Flags
FEATURE_UI_UX_PRO_MAX=true
FEATURE_PDF_ENHANCED_LAYOUT=true
